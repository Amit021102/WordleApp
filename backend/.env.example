# Reference for the environment variables the backend reads. These are plain
# process environment variables -- the app does not load a .env file itself, so
# export them or prefix the uvicorn command:
#
#   WORDLE_CORS_ORIGINS="http://localhost:4173" uvicorn app.main:app --port 8000

# Comma-separated list of origins allowed to call the API. Must include the
# origin the frontend is actually served from.
WORDLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
